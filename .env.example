# SMTP E-Mail Dispatch Configuration: Configure these via Settings to enable real e-mails
# Put the REAL values in .env (gitignored), NOT here. These are placeholders only.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=info@yourdomain.com

# INQUIRY_TO: Mailbox that receives contact-form submissions. Defaults to info@geekstab.com.
INQUIRY_TO=info@geekstab.com

